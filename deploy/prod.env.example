# Copy to deploy/prod.env on the server and replace every placeholder secret.

APP_DOMAIN=retention.myflowy.app
CADDY_ACME_EMAIL=admin@myflowy.app

POSTGRES_USER=retention
POSTGRES_PASSWORD=change-me-generate-a-long-random-password
POSTGRES_DB=retention

APP_ENV=production
CORS_ORIGINS=https://retention.myflowy.app

INFRA__DATABASE_URL=postgresql+asyncpg://retention:change-me-generate-a-long-random-password@postgres:5432/retention
INFRA__REDIS_URL=redis://redis:6379/0

SECURITY__SECRET_KEY=change-me-generate-at-least-32-random-bytes
SECURITY__FRONTEND_PUBLIC_ORIGIN=https://retention.myflowy.app
SECURITY__EMAIL_VERIFICATION_TTL_SECONDS=259200
SECURITY__PASSWORD_RESET_TTL_SECONDS=300
SECURITY__AUTH_LOG_VERIFICATION_LINK=false

SESSION__COOKIE_SECURE=1

CELERY__BROKER_URL=redis://redis:6379/1
CELERY__RESULT_BACKEND=redis://redis:6379/1
CELERY__TASK_ALWAYS_EAGER=false
CELERY__TASK_EAGER_PROPAGATES=false

BOOKING__COMPLETE_PAST_INTERVAL_MINUTES=5
BOOKING__AVAILABILITY_SLOT_STEP_MINUTES=15
BOOKING__MAX_ADVANCE_DAYS=90

SMTP__ENABLED=true
SMTP__HOST=smtp.resend.com
SMTP__PORT=587
SMTP__TLS=false
SMTP__START_TLS=true
SMTP__USERNAME=resend
SMTP__PASSWORD=change-me-resend-smtp-password
SMTP__FROM_EMAIL=noreply@retention.myflowy.app

NOTIFICATIONS__EAGER_DELIVERIES=false
NOTIFICATIONS__REMINDER_SCAN_INTERVAL_SECONDS=60
NOTIFICATIONS__REMINDER_BATCH_SIZE=100

MESSENGER_BOTS__INTERNAL_SECRET=change-me-generate-a-long-random-secret
MESSENGER_BOTS__TELEGRAM_BOT_USERNAME=
MESSENGER_BOTS__TELEGRAM_SERVICE_URL=

# Optional ops alerts. Use a separate Telegram bot/token if possible.
# ALERTS__TELEGRAM_BOT_TOKEN=
# ALERTS__TELEGRAM_CHAT_ID=

# SQLAdmin ops panel at https://<APP_DOMAIN>/admin
ADMIN__ENABLED=false
ADMIN__ALLOWED_EMAILS=ops@example.com
# ADMIN__SESSION_SECRET=change-me-if-you-want-a-separate-admin-session-key
