APP_ENV=development
CORS_ORIGINS=http://localhost:5173

INFRA__DATABASE_URL=postgresql+asyncpg://retention:retention@localhost:5432/retention
INFRA__REDIS_URL=redis://localhost:6379/0

# Signing key for email verification tokens and similar (must be long & random outside dev)
SECURITY__SECRET_KEY=change-me-in-production
# URL of the SPA (verification emails point to FRONTEND_PUBLIC_ORIGIN/verify-email?token=...)
SECURITY__FRONTEND_PUBLIC_ORIGIN=http://localhost:5173
SECURITY__EMAIL_VERIFICATION_TTL_SECONDS=259200

# When 1/true, verification URL (and subject) are echoed to logs after templates render
SECURITY__AUTH_LOG_VERIFICATION_LINK=true

# Celery
CELERY__BROKER_URL=redis://localhost:6379/1
CELERY__RESULT_BACKEND=redis://localhost:6379/1
CELERY__TASK_ALWAYS_EAGER=true
CELERY__TASK_EAGER_PROPAGATES=true
SESSION__COOKIE_SECURE=0

# SMTP (e.g. rnwood/smtp4dev on 25 without TLS in docker-compose.dev)
SMTP__ENABLED=true
SMTP__HOST=127.0.0.1
SMTP__PORT=25
SMTP__TLS=false
SMTP__START_TLS=false
SMTP__USER=
SMTP__PASSWORD=
SMTP__FROM_EMAIL=noreply@retention.by

# Booking
# Slot grid step for availability generation (minutes)
BOOKING__AVAILABILITY_SLOT_STEP_MINUTES=15
BOOKING__MAX_ADVANCE_DAYS=90
