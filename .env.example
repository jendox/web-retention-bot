APP_ENV=development
CORS_ORIGINS=http://localhost:5173

INFRA__DATABASE_URL=postgresql+asyncpg://retention:retention@localhost:5432/retention
INFRA__REDIS_URL=redis://localhost:6379/0
# Pytest uses a separate DB/Redis by default (see tests/support/infra.py); override if needed:
# INFRA__TEST_DATABASE_URL=postgresql+asyncpg://retention:retention@localhost:5432/retention_test
# INFRA__TEST_REDIS_URL=redis://localhost:6379/15

# Signing key for email verification tokens and similar (must be long & random outside dev)
SECURITY__SECRET_KEY=change-me-in-production
# URL of the SPA (verification emails point to FRONTEND_PUBLIC_ORIGIN/verify-email?token=...)
SECURITY__FRONTEND_PUBLIC_ORIGIN=http://localhost:5173
SECURITY__EMAIL_VERIFICATION_TTL_SECONDS=259200
SECURITY__PASSWORD_RESET_TTL_SECONDS=300
# When 1/true, verification URL (and subject) are echoed to logs after templates render
SECURITY__AUTH_LOG_VERIFICATION_LINK=true

# Celery
CELERY__BROKER_URL=redis://localhost:6379/1
CELERY__RESULT_BACKEND=redis://localhost:6379/1
# false (default for dev): beat enqueues, worker executes — run `make celery-worker` and `make celery-beat`
# true: tasks run inline in the caller (pytest); periodic tasks then run inside beat without a worker
CELERY__TASK_ALWAYS_EAGER=false
CELERY__TASK_EAGER_PROPAGATES=false

# Интервал Celery Beat для автозавершения прошедших записей (минуты)
BOOKING__COMPLETE_PAST_INTERVAL_MINUTES=5
SESSION__COOKIE_SECURE=0

# SMTP (e.g. rnwood/smtp4dev on 25 without TLS in docker-compose.dev)
SMTP__ENABLED=true
SMTP__HOST=127.0.0.1
SMTP__PORT=25
SMTP__TLS=false
SMTP__START_TLS=false
SMTP__USERNAME=
SMTP__PASSWORD=
SMTP__FROM_EMAIL=noreply@retention.by

# Notifications: true = send booking/verification emails in-process (no Celery worker needed)
NOTIFICATIONS__EAGER_DELIVERIES=false
NOTIFICATIONS__REMINDER_SCAN_INTERVAL_SECONDS=60
NOTIFICATIONS__REMINDER_BATCH_SIZE=100

# Messenger bot sidecars (deploy/docker-compose.bots.yml)
MESSENGER_BOTS__INTERNAL_SECRET=dev-bot-internal-secret-change-me
MESSENGER_BOTS__TELEGRAM_BOT_USERNAME=retention_studio_bot
MESSENGER_BOTS__TELEGRAM_SERVICE_URL=http://localhost:8091
# Token from @BotFather — only for bot container, not required for API-only dev
# TELEGRAM_BOT_TOKEN=
# RETENTION_API_URL=http://host.docker.internal:8000

# Booking
# Slot grid step for availability generation (minutes)
BOOKING__AVAILABILITY_SLOT_STEP_MINUTES=15
BOOKING__MAX_ADVANCE_DAYS=90

# SQLAdmin ops panel at /admin (optional; uses separate admin_session cookie)
# Login: email + password of an existing verified user listed in ADMIN__ALLOWED_EMAILS
ADMIN__ENABLED=false
ADMIN__ALLOWED_EMAILS=
# ADMIN__SESSION_SECRET=optional-separate-signing-key-for-admin-session
